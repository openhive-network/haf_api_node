# The name of the ZFS storage pool for HAF to use
ZPOOL="haf-pool"
# The name of the dataset on $ZPOOL where HAF will store its data
# HAF won't read/write anything outside of $ZPOOL/$TOP_LEVEL_DATASET,
# so you can have, e.g., multiple HAF installations on the same
# pool by changing TOP_LEVEL_DATASET
TOP_LEVEL_DATASET="haf-datadir"

# these defaults usually don't need changing
ZPOOL_MOUNT_POINT="/${ZPOOL}"
TOP_LEVEL_DATASET_MOUNTPOINT="${ZPOOL_MOUNT_POINT}/${TOP_LEVEL_DATASET}"

# COMPOSE_PROFILES are the list of HAF services you want to control when
# you run `docker compose up` etc.  It's a comma-separated list of profiles
# taken from:
# - core: the minimal HAF system of a database and hived
# - admin: useful tools for administrating HAF: pgadmin, pghero
# - apps: core HAF apps: hivemind, hafah, hafbe (balance-tracker is a subapp)
# - servers: services for routing/caching API calls: haproxy, jussi (JSON caching), varnish (REST caching)
# - monitoring: services for Prometheus, Grafana, Loki, Cadvisor , Nodeexporter, Promtail, Postresexporter, Blackboxexporter...
#   For split-stack/federated deployments, the `monitoring` bundle is also broken into sub-profiles you can mix:
#   - monitoring-central:  Prometheus + Grafana + Loki  (the central UI/storage on one host)
#   - monitoring-leaf:     Prometheus only              (a leaf instance that the central federates from)
#   - monitoring-shipper:  Promtail                     (ships container logs to LOKI_PUSH_URL; enable on every host)
#   - monitoring-targets:  hived-pme + postgresexporter (enable wherever hived/postgres run)
#   - monitoring-system:   node_exporter + cadvisor + blackbox_exporter (host-level; one stack per host)
#   - monitoring-loki-relay: socat forwarder that lets hived-pme push block_stats to a
#                            remote Loki (hived-pme has its loki upstream hardcoded). Enable
#                            on backend-only stacks where hived-pme runs but loki doesn't,
#                            and set LOKI_RELAY_TARGET=<central-loki-host>:<port>. Mutually
#                            exclusive with monitoring-central on the same stack.
# - haf-stats: the haf_stats analytics app. Deliberately NOT part of `apps` until
#   haf_stats has a release tag matching the node version (hive/haf_stats#66) AND is
#   mirrored to registry.hive.blog (hive/haf_stats#93) -- see the HAF_STATS_* block
#   below, which you must also set, because the default image does not resolve yet.
# - haf-stats-uninstall: DESTRUCTIVE teardown for haf_stats. Never add this to
#   COMPOSE_PROFILES; run it explicitly. See haf_stats.yaml.
# - haf-fyp: the haf_fyp feed app. Also NOT part of `apps`, for the same two reasons as
#   haf-stats plus one of its own: haf_fyp publishes no bare `haf_fyp` image at all, only
#   the sub-path images haf_fyp/sql, haf_fyp/python and haf_fyp/postgrest-rewriter, so
#   the conventional default cannot exist. Set the HAF_FYP_* block below. haf_fyp also
#   wants `apps` enabled alongside it: without hivemind its feeds return empty while
#   every health signal still reads green.
# - haf-fyp-uninstall: DESTRUCTIVE teardown for haf_fyp. Never add this to
#   COMPOSE_PROFILES; run it explicitly. See haf_fyp.yaml.
# - ui: deploy denser and haf block explorer UIs at /blog, /wallet, and /explorer
# COMPOSE_PROFILES="core,admin,hafah,hivemind,servers"
# COMPOSE_PROFILES="core,admin,hafah,hafbe,hivemind,servers,monitoring"
COMPOSE_PROFILES="core,admin,servers,apps"

# The registry where Hive docker images are pulled from.  Normally, you
# should set this to the default, `registry.hive.blog` or Docker Hub,
# where stable images will be published.  If you want to run pre-release
# images, change this to `registry.gitlab.syncad.com/hive` where both CI
# builds are automatically pushed.
# HIVE_API_NODE_REGISTRY=registry.hive.blog
# HIVE_API_NODE_REGISTRY=hiveio
# HIVE_API_NODE_REGISTRY=registry.gitlab.syncad.com/hive

# To use the same tagged version of all the Hive API node images,
# set it here.  You can override the tags for individual images
# below
HIVE_API_NODE_VERSION=1.28.6

# HafSQL is maintained upstream at https://gitlab.com/mahdiyari/hafsql and pulled
# from the author's Docker Hub image.  hafsql.yaml pins the version that was
# verified against this release's HAF; it is not tied to HIVE_API_NODE_VERSION.
# To run a different build, pick a tag from https://hub.docker.com/r/mahdiyari/hafsql/tags
# HAFSQL_IMAGE=mahdiyari/hafsql
# HAFSQL_VERSION=2.6.1


# Global settings

# UID and GID used by containers that write to haf-datadir.
# Setting these ensures consistent file ownership across all services.
# HAF_UID=1000
# HAF_GID=1000

# override the HAF core image's version and registry image here:
# HAF_IMAGE=${HIVE_API_NODE_REGISTRY}/haf
# HAF_VERSION=${HIVE_API_NODE_VERSION}
#
# PostgreSQL major version. From 1.29 the default HAF image runs PostgreSQL 18.
# The previous major is published alongside it as a separate image; to stay on
# PostgreSQL 17 point HAF_IMAGE at it:
# HAF_IMAGE=${HIVE_API_NODE_REGISTRY}/haf/pg17
# The two are not interchangeable on one data directory: PostgreSQL refuses to
# start on a database cluster created by another major version, so switching
# between them means stopping the stack, removing haf_db_store from the HAF
# datadir (the PostgreSQL cluster; the blockchain directory can stay) and
# replaying. A 1.28.x -> 1.29.x upgrade needs a replay regardless.

# HAF_DATA_DIRECTORY="${TOP_LEVEL_DATASET_MOUNTPOINT}"
# HAF_LOG_DIRECTORY="${TOP_LEVEL_DATASET_MOUNTPOINT}/logs"
# Block-processing logs of the HAF apps (reputation_tracker, balance_tracker, haf_block_explorer,
# nft_tracker, proxy_whitelist, hivesense and hivesense-sync) are written to ${HAF_LOG_DIRECTORY}/apps/<app>_block_processing.log in addition to
# docker logs, so they survive `docker compose down`; the logrotate profile rotates them daily.
# HAF_WAL_DIRECTORY="${TOP_LEVEL_DATASET_MOUNTPOINT}/shared_memory/haf_wal"
# HAF_MONITORING_DIRECTORY="${TOP_LEVEL_DATASET_MOUNTPOINT}/logs/monitoring"

# Directory configuration for shared memory and RocksDB storage
# These variables are optional - if not set, they default to subdirectories under TOP_LEVEL_DATASET_MOUNTPOINT
# If you need to massive sync HAF (i.e. you are not using a ZFS snapshot),
# then you can sync faster by temporarily using an in-memory shared_memory.bin.
# To do this, uncomment the HAF_SHM_DIRECTORY line below, and mount an appropriate
# tmpfs filesystem there.
# After the sync has finished, do `docker compose down` then move the shared_memory.bin
# file to the shared_memory directory, edit this file and comment the HAF_SHM_DIRECTORY
# out again to make it assume its default value, then `docker compose up -d` to restart HAF.
# HAF_SHM_DIRECTORY="/mnt/haf_shared_mem"
# HAF_ROCKSDB_DIRECTORY="/path/to/rocksdb"

# Shared memory size for HAF PostgreSQL instance
# Increase for heavy workloads or large replay operations
# HAF_SHM_SIZE=32gb

# The docker compose project name, gets prefixed onto each container name
PROJECT_NAME=haf
# The docker network name, if you run two HAF instances on the same server,
# give them different network names to keep them isolated.  Otherwise
# unimportant.
NETWORK_NAME=haf

# List of arguments for the HAF service
# ARGUMENTS=""
ARGUMENTS="--replay-blockchain"
# ARGUMENTS="--dump-snapshot=20230821"
# ARGUMENTS="--skip-hived"
# ARGUMENTS="--block-log-split=-1"
#
# Example how to use monitoring services
#
# ARGUMENTS="--replay-blockchain --stop-at-block 5000000 --block-stats-report-output=NOTIFY --block-stats-report-type=FULL --notifications-endpoint=hived-pme:9185"
#
# Mandatory options are:
# --block-stats-report-output=NOTIFY --block-stats-report-type=FULL --notifications-endpoint=hived-pme:9185

# hived listening endpoints, given as address:port. By default hived runs dual-stack:
# it binds "[::]", accepting both IPv6 and IPv4 (on images whose entrypoint predates
# dual-stack defaults, the default is 0.0.0.0). Override any of these to force a
# binding, e.g. IPv4-only:
# P2P_ENDPOINT="0.0.0.0:2001"
# WS_ENDPOINT="0.0.0.0:8090"
# HTTP_ENDPOINT="0.0.0.0:8091"

# The hived p2p port is published on the host by default (dual-stack, port 2001):
# accepting inbound peers improves the health of the p2p network. Override with
# P2P_PORT_MAPPING, e.g.:
# P2P_PORT_MAPPING="12001:2001"           # expose on an alternate host port
# P2P_PORT_MAPPING="127.0.0.1:2001:2001"  # effectively unexposed (host loopback only)
# P2P_PORT_MAPPING="0.0.0.0:2001:2001"    # expose on host IPv4 only
# P2P_PORT_MAPPING="[2001:db8::7]:2001:2001"  # expose on one specific host address
# (an empty value is not valid docker compose syntax - use the loopback form to
# unexpose; if you change the hived port via P2P_ENDPOINT, the container-side port
# in the mapping must match it)

# For CI environments or when replaying historical blocks, set EXPECTED_BLOCK_TIME
# to the timestamp of the last block being replayed. This allows healthchecks to 
# properly validate service synchronization when working with old blockchain data.
# Format: "YYYY-MM-DD hh:mm:ss" (e.g., "2016-03-24 16:05:21" for block 10000)
# EXPECTED_BLOCK_TIME=

# Control whether HAF apps track reversible data.  Not all apps support this, some 
# only track data once it has been made irreversible by being confirmed by a supermajority
# of witnesses.
# Can be overridden per-app with {BALANCE_TRACKER|REPUTATION_TRACKER|HAF_BLOCK_EXPLORER}_IS_FORKING
# IS_FORKING=TRUE

# Which activate endpoint notification for hived-pme service (log converter from hived to Prometheus metrics)
#
#  By default, 5 dashboards are available:
#
# - Blockstats(available after replay phase, showing live state of block, times, delays etc)
# - cAdvisor Docker Container - status of containers in stack, CPU, Memory, I/O, Network...)
# - Node Exporter Full - full state of host on which haf-api-node is running(full overview of available metrics)
# - Monitor Services - status of containers included in the monitoring system
# - PostgreSQL Databases - databases stats from postgresexporter
#
# Additional logs are collected from all containers in the stack via Loki and Promtail
# Default login and password for Grafana is admin/admin - remember to change it after first login
# Statistics provided by Grafana are available at the host address on port 3000 (http(s)://hostname:3000)


# The default setup will run the recommended version of HAfAH,
# you can run a custom version by un-commenting and modifying the
# values below
# HAFAH_IMAGE=${HIVE_API_NODE_REGISTRY}/hafah
# HAFAH_VERSION=${HIVE_API_NODE_VERSION}

# The default setup will run the recommended version of Hivemind using the values
# below.  You can override them here to run a custom version of Hivemind
# HIVEMIND_IMAGE=${HIVE_API_NODE_REGISTRY}/hivemind
# HIVEMIND_VERSION=${HIVE_API_NODE_VERSION}
# HIVEMIND_REWRITER_IMAGE=${HIVE_API_NODE_REGISTRY}/hivemind/postgrest-rewriter

# Additional Hivemind sync arguments
# HIVEMIND_SYNC_ARGS=--max-batch 4000

# Timeout for Hivemind API calls, any queries that take longer than
# this time will be aborted.  0 for unlimited, or give a nonzero
# time limit in milliseconds
# HIVEMIND_STATEMENT_TIMEOUT=5000

# The default setup will run the recommended version of balance tracker,
# you can run a custom version by un-commenting and modifying the
# values below
# BALANCE_TRACKER_IMAGE=${HIVE_API_NODE_REGISTRY}/balance_tracker
# BALANCE_TRACKER_VERSION=${HIVE_API_NODE_VERSION}
# BALANCE_TRACKER_IS_FORKING=TRUE


# REPUTATION_TRACKER_ADDON
# REPUTATION_TRACKER_IMAGE=${HIVE_API_NODE_REGISTRY}/reputation_tracker
# REPUTATION_TRACKER_VERSION=${HIVE_API_NODE_VERSION}
# REPUTATION_TRACKER_IS_FORKING=TRUE


# There are two ways of running Balance Tracker: as a standalone app, or
# integrated with HAF Block Explorer.  While you can technically run both,
# there's no good reason to do so--you'll just waste disk space and processing
# power maintaining two copies of the data.
# Regardless of which way you decide to run Balance Tracker, you will need
# to run a single API server, and it needs to know which schema the data is
# stored in.  It will be in "hafbe_bal" if you're running HAF Block Explorer,
# and "btracker_app" if you're running Balance Tracker standalone.
# The default behavior is to serve data from the HAF Block Explorer, but 
# if you're only running the standalone Balance Tracker, uncomment the next
# line:
# BTRACKER_SCHEMA="btracker_app"
 
# The default setup will run the recommended version of HAF block explorer,
# you can run a custom version by un-commenting and modifying the
# values below
# HAF_BLOCK_EXPLORER_IMAGE=${HIVE_API_NODE_REGISTRY}/haf_block_explorer
# HAF_BLOCK_EXPLORER_VERSION=${HIVE_API_NODE_VERSION}
# HAF_BLOCK_EXPLORER_IS_FORKING=TRUE


# Hivesense
# to compute embeddings yourself, change this to 'local':
# HIVESENSE_CONFIGURATION=sync
#
# HIVESENSE_IMAGE=${HIVE_API_NODE_REGISTRY}/hivesense
# HIVESENSE_VERSION=${HIVE_API_NODE_VERSION}
# HIVESENSE_REWRITER_IMAGE=${HIVE_API_NODE_REGISTRY}/hivesense/postgrest-rewriter
# HIVESENSE_SYNC_ARGS=--stop-at-block=1000000
# HIVESENSE_START_BLOCK=1
# HIVESENSE_WORKERS=16
# HIVESENSE_EMBEDDING_BATCH_SIZE=100
# HIVESENSE_OLLAMA=http://hivesense-ollama:11434
# embedding wire protocol: 'ollama' (default, native /api/embed) or 'openai'
# (/v1/embeddings, e.g. a llama-swap GPU pool). For 'openai', also point
# HIVESENSE_OLLAMA at that server, e.g. https://gpus.example.com
# HIVESENSE_EMBEDDING_API=ollama
#
# GPU-pool setup with local CPU fallback (see haproxy/35-ollama-remote.cfg.example
# for the full recipe):
#   - HIVESENSE_EMBEDDING_API=openai
#   - add "hivesense-llama-cpu" to COMPOSE_PROFILES (local CPU fallback server;
#     downloads its model from HuggingFace on first start)
#   - HIVESENSE_OLLAMA_REPLICAS=0 to stop the now-unused local ollama
#   - point the haproxy "ollama" backend at your pool via a compose.override.yml
#     bind mount of your 35-ollama-override.cfg
# HIVESENSE_OLLAMA_REPLICAS=1
# HIVESENSE_LLAMA_CPU_MODEL=jinaai/jina-embeddings-v5-text-small-retrieval:F16
# HIVESENSE_LLAMA_CPU_CTX=8192
# when building the hivesense indexes, we try to increase (temporarily) maintenance_work_mem to
# this value for the duration of index creation.
# if you're using the default settings (128-bit reduced embeddings, min 75 tokens), this setting
# doesn't matter much -- indexes take about an hour and a half even with only 4GB.
# But getting this right can save days of index creation time if not using reduced embeddings or
# are otherwise indexing more data
# HIVESENSE_MAINTENANCE_WORK_MEM=28

# HIVESENSE_STORE_HALFVEC_EMBEDDINGS=TRUE
# HIVESENSE_USE_HALFVEC_INDEX=TRUE
# HIVESENSE_HNSW_M=16
# HIVESENSE_HNSW_EF_CONSTRUCTION=200
#
# Dimension reduction configuration:
# HIVESENSE_USE_REDUCED_EMBEDDINGS=true
# HIVESENSE_REDUCTION_MODE=slice  # 'none', 'pca', or 'slice' (matryoshka truncation)
# Option 1: Download from URL (will be cached after first download)
#   HIVESENSE_MATRIX_SOURCE=https://gitlab.syncad.com/hive/hivesense/-/wikis/uploads/0eebabf30d7cceb5776cb62c41abb2c9/projection_matrix_768_128_20250722.json.gz
# Option 2: Use local file (for users generating their own matrices).  Should be placed in datadir's hivesense/config directory.  may be .json or .json.gz
#   HIVESENSE_MATRIX_SOURCE=projection_matrix.json
# HIVESENSE_REDUCED_DIMENSION=128

# HIVESENSE_MIN_TOKEN_THRESHOLD=75
# HIVESENSE_MIN_TOKEN_SEARCH_THRESHOLD=0

# HIVESENSE_SYNC_API=https://api.hive.blog/hivesense-api
#
# What the hivesense syncer does when the upstream has embeddings for a post that
# doesn't exist in your local hivemind database. This only happens when your
# hivemind database is inconsistent/corrupted (e.g. hivemind skipped a block after
# a mid-block crash, hive/hivemind#336).
#   skip (default) - drop the op and keep syncing; that post will never have
#                    embeddings on this node, and this node will advertise its
#                    skip count to anyone syncing from it
#   exit           - stop the syncer (the container will restart-loop) so the
#                    problem can't go unnoticed; repair hivemind by restoring a
#                    known-good snapshot and resyncing, then the syncer will
#                    resume on its own. Also refuses to sync from any upstream
#                    that advertises skipped ops (i.e. one serving a
#                    known-incomplete stream), halting before applying anything
#                    past the upstream's gap so this node can resume, complete,
#                    once the upstream is repaired.
# Set 'exit' on any node that others sync from (or that sits behind a load
# balancer with other backends, which must stay identical); 'skip' is for
# operators who prefer availability over completeness.
# HIVESENSE_MISSING_POST_ACTION=skip
# How many times (1 second apart) the syncer re-checks hivemind for a missing post
# before applying HIVESENSE_MISSING_POST_ACTION
# HIVESENSE_MISSING_POST_RETRIES=30
# Log verbosity of the hivesense syncer: DEBUG, INFO, WARNING or ERROR
# HIVESENSE_SYNC_LOG_LEVEL=INFO

# if you need to gpu accelerate your ollama, you should probably use the stock
# image instead of our smaller version.  To do so, uncomment this:
# OLLAMA_IMAGE=ollama/ollama
# OLLAMA_VERSION=0.18.0

# Default settings (jina with Matryoshka dimension reduction, no PCA matrix needed):
# HIVESENSE_MODEL=hf.co/jinaai/jina-embeddings-v5-text-small-retrieval:F16
# HIVESENSE_VECTOR_SIZE=1024
# HIVESENSE_TOKENS_PER_CHUNK=2048
# HIVESENSE_OVERLAP_AMOUNT=0.10
# HIVESENSE_EMBEDDING_BATCH_SIZE=50
# HIVESENSE_TOKENIZER_MODEL_NAME=jina-v5-small
# HIVESENSE_DOCUMENT_PREFIX="Document: "
# HIVESENSE_QUERY_PREFIX="Query: "
# HIVESENSE_NUM_CTX=8192  # must be > tokens_per_chunk; Ollama defaults to 2048
# HIVESENSE_USE_REDUCED_EMBEDDINGS=true
# HIVESENSE_REDUCTION_MODE=slice
# HIVESENSE_REDUCED_DIMENSION=128

# or for a smaller/faster model (requires PCA matrix for dimension reduction):
# HIVESENSE_MODEL=yxchia/multilingual-e5-base:F16
# HIVESENSE_VECTOR_SIZE=768
# HIVESENSE_TOKENS_PER_CHUNK=512
# HIVESENSE_OVERLAP_AMOUNT=0.15
# HIVESENSE_TOKENIZER_MODEL_NAME=e5-base # used by intfloat/multilingual-e5-base
# HIVESENSE_DOCUMENT_PREFIX="passage: "
# HIVESENSE_QUERY_PREFIX="query: "
# HIVESENSE_REDUCTION_MODE=pca
# HIVESENSE_MATRIX_SOURCE=https://gitlab.syncad.com/hive/hivesense/-/wikis/uploads/0eebabf30d7cceb5776cb62c41abb2c9/projection_matrix_768_128_20250722.json.gz

# or for a better performing but slower model that is still fast enough CPUs can embed query strings:
# HIVESENSE_MODEL=jeffh/intfloat-multilingual-e5-large:f16
# HIVESENSE_VECTOR_SIZE=1024

## or, for a significantly bigger and slower model:
## HIVESENSE_MODEL=rjmalagon/gte-qwen2-1.5b-instruct-embed-f16
## HIVESENSE_VECTOR_SIZE=1536
## HIVESENSE_TOKENS_PER_CHUNK=32768
## HIVESENSE_OVERLAP_AMOUNT=0.05
## HIVESENSE_TOKENIZER_MODEL_NAME=Qwen/Qwen2-1.5B
## HIVESENSE_DOCUMENT_PREFIX=""
## HIVESENSE_QUERY_PREFIX="Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: "

## Override the version of NFT tracker deployed on this node
# NFT_TRACKER_VERSION=${HIVE_API_NODE_VERSION}

## haf_stats. NOTE: unlike the other apps, haf_stats has no release tag yet
## (hive/haf_stats#66), so the ${HIVE_API_NODE_VERSION} default below does not resolve
## to a real image. Its CI publishes commit-SHA tags and `latest` (the newest develop
## commit whose pipeline passed), and only to registry.gitlab.syncad.com -- nothing is
## mirrored to registry.hive.blog yet (hive/haf_stats#93). Until then, set the images
## and version explicitly, e.g.
##   HAF_STATS_IMAGE=registry.gitlab.syncad.com/hive/haf_stats
##   HAF_STATS_REWRITER_IMAGE=registry.gitlab.syncad.com/hive/haf_stats/postgrest-rewriter
##   HAF_STATS_VERSION=479815fd
##
## Set the REWRITER image too: HAF_STATS_IMAGE does not feed it, so on its own the
## rewriter still resolves against HIVE_API_NODE_REGISTRY (registry.hive.blog),
## where it was never published. Neither variable takes a tag; HAF_STATS_VERSION
## supplies it. And the tag is CI_COMMIT_SHORT_SHA -- GitLab's first EIGHT hex
## characters, not git's default seven. `479815f` is not a tag; `479815fd` is.
## This is why haf_stats is gated on its own `haf-stats` profile and is NOT in `apps`.
##
## The rewriter image was renamed haf_stats/rewriter -> haf_stats/postgrest-rewriter,
## the name the other apps use (hive/haf_stats#83). haf_stats publishes both names for
## now, but a SHA from a haf_stats commit WITHOUT the rename (develop commits from
## 2026-08-02 up to d4e73b05) has its rewriter ONLY under the old name -- and older
## commits have no rewriter image at all. Pinning one of those needs the old name (still
## without a tag):
##   HAF_STATS_REWRITER_IMAGE=registry.gitlab.syncad.com/hive/haf_stats/rewriter
## UPGRADE NOTE: that includes any node pinned to such a HAF_STATS_VERSION WITHOUT
## HAF_STATS_REWRITER_IMAGE whose registry serves the old name, e.g.
## HIVE_API_NODE_REGISTRY=registry.gitlab.syncad.com/hive. Its rewriter used to resolve
## to haf_stats/rewriter:<sha> and now resolves to haf_stats/postgrest-rewriter:<sha>,
## which was never published. That failed pull stops the WHOLE `docker compose up`, not
## just haf_stats (running containers are left alone) -- set the line above, or move
## HAF_STATS_VERSION to a post-rename SHA.
# HAF_STATS_IMAGE=${HIVE_API_NODE_REGISTRY}/haf_stats
# HAF_STATS_REWRITER_IMAGE=${HIVE_API_NODE_REGISTRY}/haf_stats/postgrest-rewriter
# HAF_STATS_VERSION=${HIVE_API_NODE_VERSION}
# HAF_STATS_SERVER_LOG_LEVEL=error
#
## Recovery knob, and the reason it is worth knowing about BEFORE you need it.
## haf_stats' install asserts the operation-type registry matches the chain and exits
## non-zero when it does not -- deliberately, and unlike any sibling. Both
## haf-stats-block-processing and haf-stats-postgrest gate on the install completing
## successfully, so a tripped assert takes the whole app down and it stays down.
## Set this to 1 to start anyway. haf_stats' README prescribes
## `compose run --rm -e ...` for this; that does not work here, because pg_hba on a
## haf_api_node is keyed per container name and an ad-hoc `run` container matches no
## row -- which is why the module reads the variable from the environment instead.
# HAF_STATS_SKIP_OP_TYPE_ASSERT=0
#
## Age (seconds) past which haf-stats-block-processing reports unhealthy. The module
## passes this through explicitly; the value below is the in-image default, so setting
## it to 300 changes nothing -- raise it if a MASSIVE-mode batch reports unhealthy on a
## healthy replay. The check is OR-ed with hive.is_app_in_sync(), so it only binds
## while the app is behind. Nothing gates on this health today; it is what `docker ps`
## and any future autoheal would read.
# HAF_STATS_HEALTHCHECK_MAX_AGE_SECONDS=300
#
## TWO THINGS THIS PROFILE DOES NOT DO.
##
## 1. It is not free to enable on a running node. The haf-stats pg_hba rows live in
##    PG_ACCESS, an environment variable on the `haf` service itself, so adding this
##    app changes that service's config hash: the next `up -d` RECREATES the haf
##    container, restarting hived and PostgreSQL and interrupting every other app's
##    HAF context. On a multi-TB node the shared-memory reload is not quick. Plan it
##    as a maintenance window, not an incremental add.
##
## 2. Enabling the profile is not enough to SERVE it, because the three services that
##    route to it read bind-mounted config. haf_stats is routed at /haf-stats-api/
##    through Caddy -> Varnish -> HAProxy:7016 -> the rewriter, but caddy/Caddyfile.tmpl,
##    varnish/default.vcl and haproxy/30-proxies.cfg are bind-mounted, and changing a
##    mounted FILE does not change the service's config hash. So `docker compose up -d`
##    will NOT recreate caddy, varnish or haproxy, and the route 404s while looking
##    correctly configured on disk. Restart those three explicitly the first time:
##
##      docker compose restart caddy varnish haproxy
##
##    The status page takes haf_stats' health from the agent-check on
##    haproxy-healthchecks:7016. 1.29.0-rc2 is the first release carrying that check, so
##    on an older one the row reads `unhealthy` (not `unknown`) while the API serves --
##    see io.hive.healthcheck.port in haf_stats.yaml. That image's tag is
##    HAF_API_NODE_VERSION, falling back to HIVE_API_NODE_VERSION.

## haf_fyp. NOTE: like haf_stats, the ${HIVE_API_NODE_VERSION} defaults below do not
## resolve to real images, and for one MORE reason than haf_stats has. haf_fyp's CI
## publishes THREE sub-path images and no bare `haf_fyp` repository exists at all:
##
##   haf_fyp/sql                  the app image: install_app, process_blocks, uninstall_app
##   haf_fyp/python               the ranker daemon and the write API
##   haf_fyp/postgrest-rewriter   the public read surface in front of PostgREST
##
## That is why this block has three image variables where haf_stats has two. On top of
## that, haf_fyp's only release tag (1.29.0-rc2) predates its release lane and so
## published nothing -- the first tag cut after that lane merged is the first that will
## (hive/haf_fyp#57) -- and nothing is mirrored to registry.hive.blog. Until both are
## true, point the images at the GitLab registry and pin a version explicitly:
##
##   HAF_FYP_IMAGE=registry.gitlab.syncad.com/hive/haf_fyp/sql
##   HAF_FYP_PYTHON_IMAGE=registry.gitlab.syncad.com/hive/haf_fyp/python
##   HAF_FYP_REWRITER_IMAGE=registry.gitlab.syncad.com/hive/haf_fyp/postgrest-rewriter
##   HAF_FYP_VERSION=a48f5f78
##
## Set ALL THREE images: one does not feed the others. HAF_FYP_VERSION supplies the tag
## for all of them, so none of the image values takes one. The tag is CI_COMMIT_SHORT_SHA
## -- GitLab's first EIGHT hex characters, not git's default seven.
##
## A SHA pin survives here because no cleanup cron runs -- not because policy protects
## it. hive/haf_fyp's container_expiration_policy is DISABLED but configured name_regex
## '.*', keep 10, older_than 90d, with no carve-out for release tags: switching it on
## would prune release tags and SHA tags alike. hive/haf keeps `1\..+` forever and
## sweeps the rest (its keep-list covers release tags and several branch prefixes, but
## not commit SHAs). A commit-SHA pin in haf_fyp's own standalone stack is a 404 in that
## registry today -- but note that hive/haf_fyp#56, which is about that pin, diagnoses a
## wrong repository PATH rather than a sweep, so treat the sweep as the second-order risk
## it is rather than as a thing that issue proved. The policy question for this project is
## tracked in hive/haf_fyp#60. Prefer a release tag once haf_fyp has one that resolves.
# HAF_FYP_IMAGE=${HIVE_API_NODE_REGISTRY}/haf_fyp/sql
# HAF_FYP_PYTHON_IMAGE=${HIVE_API_NODE_REGISTRY}/haf_fyp/python
# HAF_FYP_REWRITER_IMAGE=${HIVE_API_NODE_REGISTRY}/haf_fyp/postgrest-rewriter
# HAF_FYP_VERSION=${HIVE_API_NODE_VERSION}
# HAF_FYP_SERVER_LOG_LEVEL=error
#
## The write API on /haf-fyp-admin/. BOTH of the next two ship EMPTY, and both fail
## closed that way -- read this before deciding they are misconfigured.
##
## ADMIN_API_KEY empty means every call to /v1/fyp/admin/* is rejected. Set it to a long
## random value to use them; never commit the value.
# HAF_FYP_ADMIN_API_KEY=
##
## TRUSTED_PROXY_IPS names the addresses whose X-Real-IP this app will believe, and
## X-Real-IP is the only header it reads (it rejects X-Forwarded-For, which every proxy
## in the chain appends to and whose leftmost entry the client controls).
##
## SET IT -- see below for what to. Until you do, every caller shares ONE rate-limit
## bucket -- 10 interest writes per minute for
## everyone together, which a single client can exhaust -- and the app logs an ERROR
## saying so at startup. That is fail-closed against IP forgery and fail-open against
## availability.
##
## This is worth setting only because Caddy now sends the header (`header_up X-Real-IP`,
## on a handler belonging to this app alone, added with it); before that it could not
## work at all -- see hive/haf_fyp#59.
##
## SET IT TO THE COMPOSE NETWORK'S CIDR, not to a container address. The app parses CIDRs
## precisely because Docker reassigns container addresses on recreate -- and a stale
## literal degrades in silence to the shared bucket above, with one startup warning as
## the only signal. The cost is that anything on the node can claim a client IP; the
## alternative is a value that stops being true without telling you. It ships empty
## because the right value is per-node and a wrong one is worse than none: setting it
## also enables the pre-validation charging from hive/haf_fyp#28, which is only safe once
## the bucket really identifies the caller.
# HAF_FYP_TRUSTED_PROXY_IPS=
##
## The hived this app verifies posting-key signatures against. It must be the LOCAL node:
## a hostile RPC could otherwise authorise forged interest writes. If it is unreachable
## those writes fail closed with 503.
# HAF_FYP_HIVE_RPC_URL=http://haf:8091
##
## Serves /docs, /redoc and /openapi.json from the write API. Accepted values are
## 1, true, yes or on -- anything else leaves them off, including plausible spellings
## like `enabled`. hive/haf_fyp#39 turned these OFF by default to stop advertising the
## admin surface, so switching them back on is a deliberate choice, not a default to
## restore; the module gives that API no status-page row for the same reason.
# HAF_FYP_ENABLE_DOCS=
#
## Age (seconds) past which haf-fyp-block-processing reports unhealthy. As for haf_stats
## this is cosmetic -- nothing gates on it -- and it is OR-ed with hive.is_app_in_sync(),
## so it only binds while the app is behind. The agent-check on 7017 is what actually
## reports chain staleness, and it reads neither this value nor the container's health.
# HAF_FYP_HEALTHCHECK_MAX_AGE_SECONDS=300
##
## BOTH CAVEATS ABOVE APPLY TO THIS PROFILE TOO, with one correction that matters to
## every node, not just the ones enabling it. Profiles gate SERVICES, not the values
## other services read, so several of this app's settings land unconditionally and change
## those containers' config hashes. Rendering `docker compose config` on develop and on
## this branch with `haf-fyp` OFF shows exactly what moves, and it is four containers,
## not one:
##
##   haf          PG_ACCESS gains six pg_hba rows. Recreating it restarts hived AND
##                PostgreSQL. This is the one to plan a window for.
##   pgbouncer    PGBOUNCER_USERS gains haf_fyp_user. Recreating it drops every app's
##                pooled PostgREST connections.
##   haproxy      new HAF_FYP_* maxconn values.
##   haproxy-healthchecks
##                new HAF_FYP_HEALTH_URL / shed values, and one more published port if
##                you use exposed/.
##
## So it is PULLING this version, not enabling the profile, that triggers that cycle.
##
## The second caveat applies as written: haf_fyp's routes (/haf-fyp-api/ and
## /haf-fyp-admin/, via Caddy -> Varnish -> HAProxy:7017 and :7018) live in the same
## three bind-mounted files, so `up -d` will not pick them up:
##
##      docker compose restart caddy varnish haproxy
#

## Override the version of block_explorer_ui deployed on this node (requires the 'ui' profile)
# BLOCK_EXPLORER_UI_VERSION=${HIVE_API_NODE_VERSION}

## Override the version of denser deployed on this node (requires the 'ui' profile)
# DENSER_VERSION=${HIVE_API_NODE_VERSION}

# override the version of hived used for API docs
# note that this doesn't change the version of hived actually running, you must use
# HAF_VERSION to change that.  It's rare that you will want to override this.
# HIVE_OPENAPI_VERSION=${HIVE_API_NODE_VERSION}
# TODO EMF:

# The default setup uses "Drone" as the API reverse proxy & cache for the old JSON-RPC-style
# calls.  There is the older alternate reverse proxy, "Jussi", that you can choose to use instead.
# For more info about drone/jussi, see:
# https://hive.blog/hive-139531/@deathwing/announcing-drone-or-leveling-up-hive-api-nodes-and-user-experience
# To replace Drone with Jussi, uncomment the next line:
# JSONRPC_API_SERVER_NAME=jussi

# The default setup will run the recommended version of Jussi
# you can run a custom version by un-commenting and modifying the
# values below
# JUSSI_IMAGE=${HIVE_API_NODE_REGISTRY}/jussi
# JUSSI_VERSION=latest
# JUSSI_REDIS_MAX_MEMORY=8G

# If you have chosen to run Drone instead of Jussi, it will run the
# this version by default.  You can run a custom version by un-commenting
# and modifying the values below
# DRONE_IMAGE=${HIVE_API_NODE_REGISTRY}/drone
# DRONE_VERSION=latest
# DRONE_LOG_LEVEL=warn,access_log=info

# In the default configuration, synchronous broadcast_transaction calls are not handled by
# your local stack, but instead are sent to a dedicated hived instance on api.hive.blog.
# (asynchronous broadcast_transaction calls and all other hived calls are always handled by
# your local instance of hived).
# Synchronous calls can easily tie up your hived node and cause performance problems for
# all hived API calls.  For that reason, synchronous broadcast calls are deprecated.  On
# public API servers, we typically run a separate hived instance for synchronous calls,
# so if they cause performance problems, it only impacts other users making synchronous
# calls.
# To avoid forcing every haf_api_node operator to run a second hived server, the default
# config forwards these disruptive calls to a public server dedicated to the purpose.
# If you want to handle these calls using your local hived node, or you want to forward
# these calls to a different server, override these variables:
# the values below will cause synchronous broadcasts to be handled by your own hived
# SYNC_BROADCAST_BACKEND_SERVER=haf
# SYNC_BROADCAST_BACKEND_PORT=8091
# SYNC_BROADCAST_BACKEND_SSL=no-ssl

# For running a full stack:

# The hostname you'll be running this server on.  This should be a single hostname, the public
# hostname your server will be accessible from.  This is used by the Swagger-UI REST API
# explorer for generating URLs pointing at your server.  If this isn't a public server,
# this can be a local domain name.
PUBLIC_HOSTNAME="your.hostname.com"

# Public PostgreSQL Access Configuration (optional, disabled by default)
# To enable direct PostgreSQL access for external users:
# 1. Add postgres-public/compose.postgres-public.yml to COMPOSE_FILE:
#    COMPOSE_FILE=compose.yml:postgres-public/compose.postgres-public.yml
#    (or append to existing COMPOSE_FILE if you have one)
# 2. Set the credentials below for a read-only PostgreSQL user
# 3. Two connection methods are available:
#    - Port 5432 (TLS): postgresql://user:pass@hostname:5432/haf_block_log?sslmode=require&sslnegotiation=direct
#      (Requires PostgreSQL 17+ client with libpq 17+)
#    - Port 5433 (Plain TCP): postgresql://user:pass@hostname:5433/haf_block_log
#      (Works with all PostgreSQL versions, but NOT encrypted)
# Can change the default ports of the above connection methods:
# HAFSQL_PUBLIC_PORT_SSL = 5432
# HAFSQL_PUBLIC_PORT_TCP = 5433
# HAFSQL_PUBLIC_CONNECTION_LIMIT=5  # Maximum concurrent connections for public users

# HafSQL
# To change the default public HafSQL user and password
# This user has read-only access to the haf and other apps
# HAFSQL_PUBLIC_USERNAME=hafsql_public
# HAFSQL_PUBLIC_PASSWORD=hafsql_public
# Resource limits for public SQL users (applied as PostgreSQL role settings)
# HAFSQL_PUBLIC_STATEMENT_TIMEOUT=15s    # Max query execution time (default: 15s)
# HAFSQL_PUBLIC_WORK_MEM=64MB            # Max memory per sort/hash operation
# HAFSQL_PUBLIC_TEMP_FILE_LIMIT=256MB    # Max disk space for temporary files
# Dedicated public PgBouncer hard limits (seconds unless noted otherwise)
# Keep HAFSQL_PUBLIC_QUERY_TIMEOUT a couple of seconds above HAFSQL_PUBLIC_STATEMENT_TIMEOUT:
# if you raise the statement timeout, raise the query timeout too, or PgBouncer will kill
# long queries by dropping the server connection instead of letting PostgreSQL cancel cleanly.
# HAFSQL_PUBLIC_QUERY_TIMEOUT=17
# HAFSQL_PUBLIC_QUERY_WAIT_TIMEOUT=5
# HAFSQL_PUBLIC_CANCEL_WAIT_TIMEOUT=5
# HAFSQL_PUBLIC_IDLE_TRANSACTION_TIMEOUT=15
# HAFSQL_PUBLIC_TRANSACTION_TIMEOUT=60
# HAFSQL_PUBLIC_CLIENT_IDLE_TIMEOUT=300
# HAFSQL_PUBLIC_MAX_PACKET_SIZE=16777216  # 16 MiB per query/result-row packet

# Email Alerts Configuration (optional)
# To enable email alerts when HAProxy services go down:
# 1. Set the email configuration variables below
# 2. Add "email" to your COMPOSE_PROFILES (e.g., "core,admin,servers,apps,email")
#
# SMTP server configuration for sending alerts:
# SMTP_HOST="smtp.gmail.com:587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_AUTH_TYPE="plain"  # or "login" for some servers
#
# HAProxy email alert settings:
# HAPROXY_EMAIL_TO="alerts@example.com"  # Required to enable alerts
# HAPROXY_EMAIL_FROM="noreply@${PUBLIC_HOSTNAME}"  # Sender address (optional)
# HAPROXY_EMAIL_LEVEL="notice"  # Alert level: emerg, alert, crit, err, warning, notice, info, debug (optional)

# HAProxy load shedding
#
# Each postgrest-backed backend has a static per-server concurrency cap
# (generous — several times the app's postgrest connection pool). Requests
# above the cap wait in HAProxy's queue for at most API_QUEUE_TIMEOUT, then
# fail fast with a 503 instead of piling onto an already-saturated database.
#
# To fully disable the cap and keep the old unbounded
# behavior, set the relevant *_SERVER_MAXCONN to 0 (HAProxy treats 0 as no
# limit). Dynamic shedding is off by default anyway (SHED_ARMED=false below).
# See doc/load-shedding-and-spillover.md for the full picture, including how
# to spill excess load to secondary stacks instead of returning 503s.
# HIVEMIND_SERVER_MAXCONN=64
# HAFAH_SERVER_MAXCONN=48
# BALANCE_TRACKER_SERVER_MAXCONN=32
# BLOCK_EXPLORER_SERVER_MAXCONN=32
# REPUTATION_TRACKER_SERVER_MAXCONN=32
# HIVESENSE_SERVER_MAXCONN=32
# NFT_TRACKER_SERVER_MAXCONN=32
# HAF_STATS_SERVER_MAXCONN=32
# HAF_FYP_SERVER_MAXCONN=32
## The write API's own cap. Lower than the read path on purpose: these are writes,
## and a backlog of them is worth queueing rather than accepting.
# HAF_FYP_ADMIN_SERVER_MAXCONN=16
# PROXY_WHITELIST_SERVER_MAXCONN=32
# API_QUEUE_TIMEOUT=5s
# HIVEMIND_AGENT_INTER=5s   # hivemind agent-check poll interval
#
# On top of the static caps, the haproxy-healthchecks container runs a
# poller (checks/shed_poller.sh) that watches for database overload
# (hivemind postgrest pool backlog in pg_stat_activity, or pgbouncer pool
# saturation) and can tighten each backend's effective maxconn dynamically
# through the agent-check responses: normal -> reduced -> floor and back,
# with hysteresis. The floor is never 0, so shedding cannot cause an outage.
#
# SHED_ARMED=false            # false = log-only (default): detect + log, never shed.
#                             # While disarmed the agent checks emit a bare "up"
#                             # (no maxconn:), so HAProxy is never told to cap
#                             # anything -- you can upgrade ONLY the healthchecks
#                             # image against an unchanged haproxy config to see
#                             # what shedding WOULD do, purely from the logs.
#                             # Set true only after reviewing those decisions.
# SHED_POLL_INTERVAL=5        # seconds between overload polls
# SHED_CONFIRMATIONS=2        # consecutive overloaded polls before tightening a notch
# SHED_COOLDOWN=3             # consecutive quiet polls before loosening a notch
# Tune the overload thresholds to the app's ACTUAL postgrest pool sizes --
# the defaults assume the stock pools (hivemind PGRST_DB_POOL=10). Rules of
# thumb: SHED_OVERLOAD_ACTIVE ~ 80% of hivemind's pool;
# SHED_OVERLOAD_TOTAL_ACTIVE comfortably above normal busy concurrency
# (~65% of the sum of all postgrest pools). Worked example for a deployment
# running hivemind pool 30 / hafah 15 / pgbouncer max_db_connections 50:
#   SHED_OVERLOAD_ACTIVE=24
#   SHED_OVERLOAD_TOTAL_ACTIVE=45
# SHED_OVERLOAD_ACTIVE=8      # hivemind-postgrest active queries to count as backlog...
# SHED_OVERLOAD_AGE_S=2       # ...when the oldest is at least this old (seconds)
# SHED_OVERLOAD_TOTAL_ACTIVE=25  # or this many total non-idle backends
#
# Per-app "normal reduced floor" maxconn triples used in the agent replies.
# Keep "normal" equal to the *_SERVER_MAXCONN static cap for that app.
# HIVEMIND_SHED_MAXCONNS="64 12 6"
# HAFAH_SHED_MAXCONNS="48 10 5"
# HAFBE_SHED_MAXCONNS="32 8 4"
# BTRACKER_SHED_MAXCONNS="32 8 4"
# REPTRACKER_SHED_MAXCONNS="32 8 4"
# HIVESENSE_SHED_MAXCONNS="32 8 4"
# NFTTRACKER_SHED_MAXCONNS="32 8 4"
# HAF_STATS_SHED_MAXCONNS="32 8 4"
# HAF_FYP_SHED_MAXCONNS="32 8 4"
# PROXY_WHITELIST_SHED_MAXCONNS="32 8 4"
#
# pgbouncer stats connection for the pool-saturation signal. Works as-is
# with the default auth_type=trust. If you use PGBOUNCER_AUTH_TYPE=md5, add
# stats:<password> to PGBOUNCER_USERS_WITH_PASSWORDS and include the
# password here, or set this empty to disable the pgbouncer signal.
# POSTGRES_URL_PGBOUNCER="postgresql://stats@pgbouncer:6432/pgbouncer"

# Haskell runtime (GC) options for the hivemind postgrest server.
# The upstream postgrest binary is built with parallel GC disabled ("-qg"),
# so on a busy node a major garbage collection can stall ALL hivemind API
# dispatch for tens of seconds while postgres sits idle — observed as
# periodic ~1-minute latency pulses and the load spikes that follow as the
# backlog drains. Enabling the concurrent ("nonmoving") collector eliminates
# the long pauses, trading ~10-20% steady-state CPU/memory in the postgrest
# process. Recommended on nodes serving real traffic:
# HIVEMIND_POSTGREST_GHCRTS="--nonmoving-gc"

# PostgREST server log levels
# https://docs.postgrest.org/en/latest/references/configuration.html#log-level
#BALANCE_TRACKER_SERVER_LOG_LEVEL=error
#BLOCK_EXPLORER_SERVER_LOG_LEVEL=error
#HAFAH_SERVER_LOG_LEVEL=error
#HIVEMIND_SERVER_LOG_LEVEL=error
#REPUTATION_TRACKER_SERVER_LOG_LEVEL=error

# There are several ways you can configure serving HTTP/HTTPS.  Some examples:
# - to serve API using HTTPS with automatic redirect from HTTP -> HTTPS (the default), 
#   just give the hostname:
#     CADDY_SITES="your.hostname.com"
#   In the normal case, where you want to serve HTTP/HTTPS from the hostname you set in
#   PUBLIC_HOSTNAME above, you don't need to set this variable, it will automatically take
#   the value of PUBLIC_HOSTNAME
# - to serve using only HTTP (if you have nginx or something else handling SSL termination),
#   you can use:
#     CADDY_SITES="http://your.hostname.com"
#   or even:
#     CADDY_SITES="http://"
#   if you want to respond on any hostname
# - to serve on either HTTP or HTTPS (i.e., respond to HTTP requests in the clear, instead of
#   issuing a redirect):
#     CADDY_SITES="http://your.hostname.com, https://your.hostname.com"
# - to serve on multiple hostnames, separate them with a comma and space:
#     CADDY_SITES="your.hostname.com, your.other-hostname.net"
# CADDY_SITES="your.hostname.com"

#####################################################################
# Caddy Web Server Configuration
#####################################################################

# TLS Configuration
# By default, Caddy generates a self-signed certificate for development.
# Set to false to let Caddy obtain a real certificate from LetsEncrypt.
# WARNING: LetsEncrypt requires PUBLIC_HOSTNAME to be reachable from the internet.
# CADDY_TLS_SELF_SIGNED=true

# Trusted Proxies
# IPs trusted to provide X-Forwarded-For headers for client IP detection.
# Default: private_ranges (covers Docker networks, 10.x, 172.16-31.x, 192.168.x)
# Set empty to disable: CADDY_TRUSTED_PROXIES=
# CADDY_TRUSTED_PROXIES=private_ranges

# PROXY protocol
# Accept the PROXY protocol on the HTTPS listener so the real client IP is preserved when
# Caddy runs behind a TCP / SNI-passthrough proxy (e.g. HAProxy configured with send-proxy),
# which otherwise makes every request appear to come from the proxy. Set this to the CIDR(s)
# of the trusted proxy allowed to send the PROXY header (space-separated for multiple).
# Only enable this when such a proxy is actually in front of Caddy -- otherwise clients could
# spoof their source address. Empty (default) = disabled.
# CADDY_PROXY_PROTOCOL_ALLOW=192.168.4.2/32

# Rate Limiting
# Protects against API abuse. Uses client IP (respects X-Forwarded-For from trusted proxies).
# CADDY_RATE_LIMIT_ENABLED=true
# CADDY_RATE_LIMIT_EVENTS=600
# CADDY_RATE_LIMIT_WINDOW=1m

# Admin Endpoint Access Control
# Restricts /admin/* to localhost and Docker host by default.
# Set to false to allow access from anywhere (protect with basicauth via snippets).
# CADDY_ADMIN_LOCAL_ONLY=true
# Additional IPs to allow (space-separated): CADDY_ADMIN_ALLOWED_IPS=192.168.1.0/24

# DEPRECATED: Old-style snippet variables (kept for backwards compatibility)
# These work but prefer the CADDY_* variables above.
# To disable self-signed cert: use CADDY_TLS_SELF_SIGNED=false instead of /dev/null
# To allow admin from anywhere: use CADDY_ADMIN_LOCAL_ONLY=false instead of /dev/null
# TLS_SELF_SIGNED_SNIPPET=caddy/self-signed.snippet
# LOCAL_ADMIN_ONLY_SNIPPET=caddy/local-admin-only.snippet


# Caddy will only accept requests on the /admin/ endpoints over https by default.
# This is so that you can password-protect them with HTTP basicauth.
# However, if you've configured your server to only serve http, and something
# upstream is providing SSL, you can change this to allow access to the
# admin endpoints.
# ADMIN_ENDPOINT_PROTOCOL=http

# Monitoring env variables
#
# PROMETHEUS_VERSION=v2.49.1
# NODE_EXPORTER_VERSION=v1.7.0
# CADVISOR_VERSION=v0.47.2
# GRAFANA_VERSION=10.3.3
# LOKI_VERSION=2.9.4
# PROMTAIL_VERSION=2.9.4
# HIVED_PME_VERSION=49a7312d
# BLACKBOX_VERSION=v0.24.0
# DATA_SOURCE="postgresql://postgres@haf:5432/postgres?sslmode=disable"
#
# Identity for this Prometheus instance. Substituted into prometheus.yml's
# global.external_labels at startup, so federated metrics in the central
# Grafana carry origin labels. Default role is "default" and instance is
# the compose project name.
# PROMETHEUS_ROLE=primary-frontend
# PROMETHEUS_INSTANCE=hbt4-frontend
#
# Where Promtail pushes container logs. Defaults to the local loki service.
# Set to a remote URL on stacks that ship to a central Loki on another host,
# e.g. via the port exposed by exposed/monitoring.exposed.yaml.
# LOKI_PUSH_URL=http://172.16.100.4:23100/loki/api/v1/push
#
# Used only when COMPOSE_PROFILES contains monitoring-loki-relay. host:port
# of the central Loki this stack's hived-pme should push block_stats to.
# Format is host:port (no scheme, no path) — socat does plain TCP forwarding.
# LOKI_RELAY_TARGET=172.16.100.4:23100
#
# Path to a deployment-local directory of additional Prometheus scrape config
# files (loaded via the `extra/*.yml` glob in prometheus.yml). Defaults to
# the gitignored ./monitoring/prometheus-extra/. Override only if you keep
# host-specific scrape configs (e.g. federation jobs) in a different path.
# MONITORING_EXTRA_CONFIG_DIR=./monitoring/prometheus-extra
