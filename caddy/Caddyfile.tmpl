{
  order rate_limit before basicauth

{{ $trustedProxies := getenv "CADDY_TRUSTED_PROXIES" "private_ranges" -}}
{{ $proxyProtocolAllow := getenv "CADDY_PROXY_PROTOCOL_ALLOW" "" -}}
{{ if or (ne $trustedProxies "") (ne $proxyProtocolAllow "") }}
  servers {
{{- if ne $trustedProxies "" }}
    trusted_proxies static {{ $trustedProxies }}
{{- end }}
{{- if ne $proxyProtocolAllow "" }}
    # Accept the PROXY protocol header from the listed proxy CIDR(s) so the real client
    # IP is preserved when Caddy sits behind a TCP/SNI-passthrough proxy (e.g. HAProxy).
    # The `tls` wrapper MUST stay after `proxy_protocol`. Enable via CADDY_PROXY_PROTOCOL_ALLOW.
    listener_wrappers {
      proxy_protocol {
        allow {{ $proxyProtocolAllow }}
      }
      tls
    }
{{- end }}
  }
{{ end }}

  # Import Layer4 configuration for PostgreSQL TCP proxy (if postgres-public compose yaml files are included)
  import layer4-postgres-snippets/*.snippet
}

# Simple caddy config, handles SSL and forwards everything to varnish
{$CADDY_SITES} {
{{/* TLS self-signed logic with backwards compatibility */}}
{{- $newTlsVar := getenv "CADDY_TLS_SELF_SIGNED" -}}
{{- $oldTlsVar := getenv "TLS_SELF_SIGNED_SNIPPET" -}}
{{- $useSelfSigned := true -}}
{{- if ne $newTlsVar "" -}}
  {{- $useSelfSigned = eq $newTlsVar "true" -}}
{{- else if ne $oldTlsVar "" -}}
  {{- $useSelfSigned = strings.Contains $oldTlsVar "self-signed.snippet" -}}
{{- end -}}
{{ if $useSelfSigned }}
  # Use self-signed certificate (default for development)
  tls internal
{{ end }}

  # User-provided snippets (from gitignored caddy/snippets/ directory)
  import snippets/*.snippet

  # Block known abusers
  @blacklisted_ips remote_ip 185.238.72.170 185.130.44.60 24.209.251.17
  handle @blacklisted_ips {
    respond 403
  }

{{/* Rate limiting logic */}}
{{- $rateLimitEnabled := getenv "CADDY_RATE_LIMIT_ENABLED" "true" -}}
{{ if ne $rateLimitEnabled "false" }}
  # Rate limit by client IP
  rate_limit {
    zone apilimit {
      key {client_ip}
      events {{ getenv "CADDY_RATE_LIMIT_EVENTS" "600" }}
      window {{ getenv "CADDY_RATE_LIMIT_WINDOW" "1m" }}
    }
  }
{{ end }}

  # Handle CORS pre-flight checks here, instead of passing them through
  @cors_preflight method OPTIONS
  handle @cors_preflight {
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range"
    header Access-Control-Max-Age "3600"
    respond 204
  }

  # Serve robots.txt to block web scrapers from public sites
  handle /robots.txt {
    header Content-Type "text/plain; charset=utf-8"
    respond `User-agent: *
Disallow: /blog/
Disallow: /explorer/
Disallow: /wallet/
` 200
  }

  # reverse-proxy to the admin tools
  redir /admin /admin/

{{/* Admin local-only restriction with backwards compatibility */}}
{{- $newAdminVar := getenv "CADDY_ADMIN_LOCAL_ONLY" -}}
{{- $oldAdminVar := getenv "LOCAL_ADMIN_ONLY_SNIPPET" -}}
{{- $adminLocalOnly := true -}}
{{- if ne $newAdminVar "" -}}
  {{- $adminLocalOnly = eq $newAdminVar "true" -}}
{{- else if ne $oldAdminVar "" -}}
  {{- $adminLocalOnly = strings.Contains $oldAdminVar "local-admin-only.snippet" -}}
{{- end -}}
{{ if $adminLocalOnly }}
  # Restrict admin to localhost and Docker host (IPv4 and IPv6)
  @admin_blocked {
    path /admin /admin/*
    not {
      remote_ip 127.0.0.1 ::1 {{ getenv "DOCKER_GATEWAY_IP" }}{{ if getenv "DOCKER_GATEWAY_IP6" }} {{ getenv "DOCKER_GATEWAY_IP6" }}{{ end }}{{ if getenv "CADDY_ADMIN_ALLOWED_IPS" }} {{ getenv "CADDY_ADMIN_ALLOWED_IPS" }}{{ end }}
    }
  }
  handle @admin_blocked {
    respond "Access denied" 403
  }
{{ end }}

  # restrict the /admin endpoints to the specified protocol.  This is for the
  # usual case where you use basicauth to protect the endpoint, and want to prevent
  # it from being accessed via http.
  @admin_wrong_protocol {
    not protocol {$ADMIN_ENDPOINT_PROTOCOL}
    path /admin/*
  }
  handle @admin_wrong_protocol {
    respond "Admin endpoints are only accessible via {$ADMIN_ENDPOINT_PROTOCOL}" 403
  }

  # Route /admin/grafana to Grafana (handled separately to preserve full path)
  @admin_grafana {
    protocol {$ADMIN_ENDPOINT_PROTOCOL}
    path /admin/grafana /admin/grafana/*
  }
  handle @admin_grafana {
    import admin-snippets/*.snippet
    reverse_proxy http://grafana:3000 {
      # Strip the basicauth Authorization header that the password-for-admin
      # snippet just consumed. Grafana's auth precedence puts Basic ahead of
      # session cookies, so a Caddy-only credential leaks through and fails
      # against Grafana's user DB, breaking every panel data query.
      header_up -Authorization
    }
  }

  @admin {
    protocol {$ADMIN_ENDPOINT_PROTOCOL}
    path /admin/*
  }
  handle @admin {
    uri strip_prefix /admin
    import admin-snippets/*.snippet

    # Route /admin/pgadmin to pgAdmin
    redir /pgadmin /admin/pgadmin/
    handle_path /pgadmin/* {
      reverse_proxy http://pgadmin {
        header_up X-Script-Name "/admin/pgadmin"
      }
    }

    # Route /admin/pgadmin to pghero
    redir /pghero /admin/pghero/
    handle_path /pghero/* {
      rewrite * /admin/pghero{uri}
      reverse_proxy http://pghero:8080
    }

    # Route /admin/haproxy to haproxy's stats page
    redir /haproxy /admin/haproxy/
    handle_path /haproxy/* {
      rewrite * /admin/haproxy{uri}
      reverse_proxy http://haproxy:8000
    }

    redir /pgbadger /admin/pgbadger/
    handle_path /pgbadger/* {
      @pgbadger_report_missing not file {
        root /etc/caddy/pgbadger
        try_files index.html
      }

      redir @pgbadger_report_missing /admin/pgbadger_instructions
      root * /etc/caddy/pgbadger
      file_server
    }

    # Route /admin/dozzle to dozzle log viewer
    redir /dozzle /admin/dozzle/
    handle_path /dozzle/* {
      rewrite * /admin/dozzle{uri}
      reverse_proxy http://dozzle:8080
    }

    # Route /admin/versions to the version display app
    redir /versions /admin/versions/
    handle_path /versions/* {
      reverse_proxy http://version-display
    }

    root * /etc/caddy/admin_html
    file_server
  }

  handle /explorer {
      reverse_proxy http://block-explorer-ui
  }
  handle /explorer/* {
      reverse_proxy http://block-explorer-ui
  }

  handle /blog {
      reverse_proxy http://denser-blog
  }
  handle /blog/* {
      reverse_proxy http://denser-blog
  }

  handle /wallet {
      reverse_proxy http://denser-wallet
  }
  handle /wallet/* {
      reverse_proxy http://denser-wallet
  }

  # Route all POST calls to the root URL to jussi/drone (assume they're old-style JSON-RPC calls)
  @post_to_root {
    method POST
    path /
  }
  handle @post_to_root {
    # Add CORS headers
    header {
      Access-Control-Allow-Origin "*"
      Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
      Access-Control-Allow-Headers "DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range"
      Access-Control-Max-Age "3600"
    }
    reverse_proxy http://{$JSONRPC_API_SERVER_NAME}:9000 {
      # Retry once on transient errors. Drone reaps idle keepalive connections
      # before Caddy's pool notices, so a low-traffic standby occasionally hits
      # "use of closed network connection" on the first attempt; the retry
      # opens a fresh connection and succeeds.
      lb_try_duration 2s
      lb_retries 1
      # remove any CORS headers sent by jussi/drone so we don't have duplicates
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Max-Age
      # we're not overriding these, they're added by drone but not necessary
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Expose-Headers
    }
  }

  # haf_fyp is handled here rather than on @rest_apis below, for ONE reason: the
  # `header_up X-Real-IP` line. That line is what makes this app's per-client rate
  # limiting work at all, and adding it to the shared handler would change what the other
  # twelve apps on this node receive -- so the shared stanza stays byte-identical to what
  # it was, and this block carries the change alone.
  #
  # The two matchers are disjoint (these paths appear here and in no other matcher), so
  # the order of the two `handle` blocks does not matter. Everything below except the
  # X-Real-IP line is a deliberate copy of @rest_apis' handler: keep them in step if that
  # one changes.
  @haf_fyp_apis {
    path /haf-fyp-api/* /haf-fyp-admin/*
  }

  handle @haf_fyp_apis {
    # Add CORS headers -- same as @rest_apis. Copied unchanged rather than tightened: a
    # browser front-end is this app's main consumer and is cross-origin by construction.
    # Having its own block is what would MAKE a narrower policy possible later without
    # touching the siblings.
    header {
      Access-Control-Allow-Origin "*"
      Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
      Access-Control-Allow-Headers "DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range"
      Access-Control-Max-Age "3600"
    }
    reverse_proxy http://varnish {
      # The authoritative client address, and the whole reason this block exists. The
      # chain is Caddy -> Varnish -> HAProxy, so by the time a request reaches the app
      # the socket peer is HAProxy and every caller looks identical: haf_fyp's write
      # limits (10 interest writes a MINUTE) were one bucket for the whole internet,
      # which any single caller could exhaust.
      #
      # X-Forwarded-For cannot serve the purpose -- all three proxies append to it and
      # its leftmost entry is whatever the client sent -- which is why the app reads
      # X-Real-IP only. `header_up` REPLACES, so a client-supplied X-Real-IP cannot
      # survive this hop.
      #
      # {client_ip}, not {remote_host}: identical when Caddy is the edge, but where Caddy
      # itself sits behind another proxy -- the case `trusted_proxies static
      # private_ranges` above is configured for -- {remote_host} is that proxy's address
      # and every caller silently collapses into one bucket again, which is the exact
      # failure this line exists to prevent. It is also what this file's own rate_limit
      # directive keys on.
      #
      # One caveat this inherits rather than introduces: with `trusted_proxies static
      # private_ranges` above, {client_ip} walks X-Forwarded-For whenever the socket peer
      # is itself in a private range. This file's own rate_limit already keys on it, but
      # this line is the first thing to make the value load-bearing for an APP-side
      # control -- so a node fronted by another proxy on a private address should narrow
      # CADDY_TRUSTED_PROXIES to that proxy.
      #
      # The app still has to name this edge in HAF_FYP_TRUSTED_PROXY_IPS before the
      # header means anything to it; see .env.example.
      header_up X-Real-IP {client_ip}
      # Retry once on transient errors (same idle-keepalive race as the
      # JSON-RPC handler above, against varnish/postgrest backends).
      lb_try_duration 2s
      lb_retries 1
      # remove any CORS headers sent by the rest api servers so we don't have duplicates
      # (right now, postgrest doesn't add any of these headers, this is just defensive)
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Max-Age
    }
  }

  @rest_apis {
    path /hafah-api/* /balance-api/* /reputation-api/* /hafbe-api/* /hivesense-api/* /hivemind-api/* /nft-tracker-api/* /haf-stats-api/* /proxy-whitelist-api/* /hived-api/* /wallet-api/* /hafsql /hafsql/* /status-api/*
  }

  handle @rest_apis {
    # Add CORS headers
    header {
      Access-Control-Allow-Origin "*"
      Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
      Access-Control-Allow-Headers "DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range"
      Access-Control-Max-Age "3600"
    }
    reverse_proxy http://varnish {
      # Retry once on transient errors (same idle-keepalive race as the
      # JSON-RPC handler above, against varnish/postgrest backends).
      lb_try_duration 2s
      lb_retries 1
      # remove any CORS headers sent by the rest api servers so we don't have duplicates
      # (right now, postgrest doesn't add any of these headers, this is just defensive)
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Max-Age
    }
  }

  # Route everything else (currently just swagger documentation)
  reverse_proxy http://swagger
}
